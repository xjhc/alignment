# The dist directory contains build output.
# You should commit this folder.
# More info: https://vitejs.dev/guide/build.html#the-outdir
# except when developing a library
dist
dist-ssr
/dist-ssr/
*.mjs.map
*.js.map

# Storybook
storybook-static

# Chromatic
.chromatic

# Test results
test-results/
