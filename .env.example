
# --- Azure Infrastructure ---
# A short, unique name for your app (e.g., "alignment-prod")
UNIQUE_NAME="<your-unique-name>"
RESOURCE_GROUP="rg-alignment-v1"
LOCATION="eastus"
VM_NAME="vm-alignment"
VM_USERNAME="azureuser"

# --- Application Source ---
# The URL to your git repository
REPO_URL="https://github.com/<your-username>/alignment.git"

# --- Application Configuration ---
REDIS_PASSWORD=your-redis-password-here
REDIS_ADDR=redis:6379
PORT=8080

# --- Security ---
JWT_SECRET=your-jwt-secret-here
ADMIN_API_KEY=your-admin-api-key-here

# --- Environment ---
ENVIRONMENT=production
LOG_LEVEL=info

# --- Monitoring Configuration ---
GF_SECURITY_ADMIN_PASSWORD=your-grafana-password-here
PROMETHEUS_RETENTION_TIME=200h

# --- Database Configuration (PostgreSQL for production) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=alignment
POSTGRES_USER=alignment_user
POSTGRES_PASSWORD=your-postgres-password-here