# Unique name for this deployment, used in resource naming
UNIQUE_NAME=alignment-prod

# Azure resource group and location
RESOURCE_GROUP=alignment-prod-rg
LOCATION=eastus

# VM settings
VM_NAME=alignment-vm
VM_USERNAME=azureuser

# Git repository for deployment
REPO_URL=https://github.com/xjhc/alignment.git

# Security secrets
REDIS_PASSWORD=YourSecureRedisPassword
JWT_SECRET=YourSuperSecretJWTKeyThatIsVeryLong
ADMIN_API_KEY=YourSecureAdminAPIKey

# PostgreSQL settings
POSTGRES_DB=alignment
POSTGRES_USER=alignment_user
POSTGRES_PASSWORD=YourSecurePostgresPassword
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Monitoring settings
GF_SECURITY_ADMIN_PASSWORD=YourGrafanaAdminPassword
PROMETHEUS_RETENTION_TIME=200h