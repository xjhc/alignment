{
  "id": null,
  "title": "Alignment Game Performance", 
  "tags": ["alignment", "game", "performance"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Active Games",
      "type": "stat",
      "targets": [
        {
          "expr": "alignment_games_active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Active Lobbies",
      "type": "stat",
      "targets": [
        {
          "expr": "alignment_lobbies_active",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Connected Players",
      "type": "stat",
      "targets": [
        {
          "expr": "alignment_players_connected",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 4,
      "title": "Games Created (Rate)",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(alignment_games_created_total[5m])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "id": 5,
      "title": "Action Processing Duration",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(alignment_action_processing_duration_seconds_bucket[5m]))",
          "refId": "A",
          "legendFormat": "95th percentile"
        },
        {
          "expr": "histogram_quantile(0.50, rate(alignment_action_processing_duration_seconds_bucket[5m]))",
          "refId": "B", 
          "legendFormat": "Median"
        }
      ],
      "yAxes": [
        {
          "unit": "s"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 6,
      "title": "Actions Processed by Type",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(alignment_actions_processed_total[5m])",
          "refId": "A",
          "legendFormat": "{{action_type}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    }
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "schemaVersion": 16,
  "version": 0
}